    "NSUserTrackingUsageDescription" : {
      "comment" : "Privacy - Tracking Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نستخدم بيانات الأجهزة لقياس الأداء الإعلاني وتحسين Photo Revival"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "We use device data to measure advertising performance and improve Photo Revival."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gumagamit kami ng device data para sukatin ang pag - aanunsiyo at pagbutihin ang Photo Revival00."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use device data to measure advertising performance and improve Photo Revival."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम विज्ञापन प्रदर्शन को मापने और Photo Revival में सुधार करने के लिए डिवाइस डेटा का उपयोग करते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We use device data to measure advertising performance and improve Photo Revival."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "広告のパフォーマンスを測定し、Photo Revivalを改善するために装置データを使用します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami menggunakan data perangkat untuk mengukur kinerja iklan dan meningkatkan Photo Revival."
