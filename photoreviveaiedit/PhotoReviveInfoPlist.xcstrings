    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy - Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival يوفر الصور والفيديو الذي تصنعه لمكتبة الصور"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Photo Revival saves the photos and videos you create to your photo library."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival00 ang nagliligtas sa mga larawan at video na ginawa mo sa iyong photo library."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival saves the photos and videos you create to your photo library."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival उन फ़ोटो और वीडियो को बचाता है जिन्हें आप अपनी फोटो लाइब्रेरी में बनाते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival saves the photos and videos you create to your photo library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revivalは、写真ライブラリに作成した写真や動画を保存します。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival saves the photos and videos you create to your photo library."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival, fotoğraf kütüphanenize yarattığınız fotoğrafları ve videoları kurtarır."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photo Revival saves the photos and videos you create to your photo library."
          }
        },
        "vi" : {
          "stringUnit" : {
