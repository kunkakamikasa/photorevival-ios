    "Tell us how we can improve. Your suggestions\nmean a lot!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرنا كيف يمكننا تحسين اقتراحاتك\nيعني الكثير!"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabihin sa amin kung paano kami susulong.\nNapakarami!"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספרו לנו כיצד נוכל לשפר את ההצעות שלכם\nזה הרבה!"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें बताएं कि हम कैसे सुधार सकते हैं।\nबहुत कुछ मतलब!"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beritahu kami bagaimana kami bisa meningkatkan.\nsangat berarti!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改善方法を教えてください。あなたの提案\nたくさん!"
