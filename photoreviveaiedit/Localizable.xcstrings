          }
        }
      }
    },
    "Tell us what you would like to see improved. A screenshot is optional." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرنا ماذا تريد أن ترى متحسّناً، التصويب اختياري."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sabihin mo sa amin kung ano ang gusto mong makita na bumuti."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ספר לנו מה אתה רוצה לראות משופר, צילום מסך הוא אופציונלי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें बताएं कि आप क्या सुधारना चाहते हैं। एक स्क्रीनशॉट वैकल्पिक है।"
