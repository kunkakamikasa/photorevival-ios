    "You are responsible for your rendered content. Use our app\nlegally and ethically. Our policies apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت مسؤول عن مضمونك\nقانونيا وأخلاقيا، تطبق سياساتنا."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gamitin ang aming app\nKapit sa batas at etika ang ating mga patakaran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה אחראי לתוכן ההפוך שלך\nבאופן חוקי ומוסרי, המדיניות שלנו חלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपनी सामग्री के लिए जिम्मेदार हैं।\nकानूनी रूप से और नैतिक रूप से हमारी नीतियां लागू होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bertanggung jawab atas isi yang diberikan Anda. Gunakan aplikasi kami\nSecara hukum dan etis kebijakan kami berlaku."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レンダリングされたコンテンツに責任を負います。アプリを使用する\n法的かつ倫理的に。当社の方針が適用されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bertanggung jawab untuk konten terjemahan Anda. Gunakan aplikasi kami\nKebijakan kami berlaku."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanızdan sorumlusunuz. Uygulamamızı kullanın.\nYasal ve etik olarak, politikalarımız geçerlidir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا فرض ہے کہ آپ اِس ویب‌سائٹ پر مواد استعمال کریں ۔\nقانونی اور اخلاقی طور پر ہماری پالیسیوں کا اطلاق ہوتا ہے ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn phải chịu trách nhiệm về nội dung được trình bày.\nChính sách của chúng tôi áp dụng."
          }
        }
      }
    },
    "You are responsible for your rendered content. Use our app legally and ethically. Our policies apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت مسؤول عن مضمونك، استخدم تطبيقنا بشكل قانوني وأخلاقي"
          }
        },
        "fil" : {
