            "value" : "אתה אחראי לתוכן ההפוך שלך. השתמש ביישום שלנו באופן חוקי ואתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपनी सामग्री के लिए जिम्मेदार हैं। कानूनी रूप से और नैतिक रूप से हमारे ऐप का उपयोग करें। हमारी नीतियां लागू होती हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bertanggung jawab untuk isi yang diberikan Anda. gunakan aplikasi kami secara hukum dan etis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レンダリングされたコンテンツに責任があります。当社のアプリを適法かつ倫理的に使用してください。当社のポリシーが適用されます。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gunakan aplikasi kami secara hukum dan etika."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamamızı yasal ve etik olarak kullanın. Politikalarımız geçerlidir."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہماری پالیسیوں کا اطلاق آپ پر ہوتا ہے ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anh phải chịu trách nhiệm về nội dung được trình bày, sử dụng ứng dụng hợp pháp và đạo đức của chúng tôi."
          }
        }
      }
    },
    "You will need to sign in again to access your account." : {
