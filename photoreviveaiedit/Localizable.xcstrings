        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô tả kiểu dáng, chủ thể và kết quả mong đợi. Một hình ảnh tham chiếu là tùy chọn nhưng hữu ích."
          }
        }
      }
