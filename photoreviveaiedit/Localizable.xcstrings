    "This action is permanent and cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهذا العمل دائم ولا يمكن أن يُبطل."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pagkilos na ito ay permanente at hindi maaaring ipagpaliban."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו היא קבועה ולא ניתן לבטלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कार्रवाई स्थायी है और नहीं हो सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aksi ini permanen dan tidak dapat dibatalkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアクションは恒久的であり、元に戻すことはできません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini permanen dan tidak dapat dibatalkan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu eylem kalıcıdır ve geri alınamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ عمل مستقل ہے اور نا قابل عمل ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hành động này là vĩnh viễn và không thể thay đổi."
          }
        }
      }
    },
    "This creation will be permanently deleted and cannot be recovered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وسيتم حذف هذا الخلق بصورة دائمة ولا يمكن استرداده."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang paglalang na ito ay permanenteng aalisin at hindi na maibabalik."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יצירה זו תימחק לצמיתות ולא ניתן לשחזר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह रचना स्थायी रूप से नष्ट हो जाएगी और इसे ठीक नहीं किया जा सकता है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penciptaan ini akan dihapus permanen dan tidak dapat dipulihkan."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この作品は永続的に削除され、復元できません。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coged ciptaan ini akan dihapus permanen dan tidak dapat dipulihkan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu yaratım kalıcı olarak silinecek ve kurtarılamaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس مخلوق کو مستقل طور پر ختم کر دیا جائے گا اور دوبارہ بحال نہیں کیا جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tạo vật này sẽ bị xoá hoàn toàn và không thể phục hồi."
          }
        }
      }
    },
