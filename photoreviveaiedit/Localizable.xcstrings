        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beritahu kami bagaimana kami bisa memperbaiki diri.\nSangat berarti!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bize nasıl geliştirebileceğimizi söyleyin. Öneriniz\nÇok şey demek!"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آئیں ، اِس سلسلے میں کچھ مشورے پر غور کریں ۔\nبہت مطلب ہے!"
