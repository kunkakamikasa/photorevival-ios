    "Describe the style, subject and expected result. A reference screenshot is optional but helpful." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرجى وصف الأسلوب والموضوع والنتيجة المتوقعة."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilarawan ang istilo, paksa at inaasahang resulta. Ang reference screenshot ay opsyonal ngunit nakatutulong."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תאר את הסגנון, הנושא והתוצאה הצפויה: צילום מסך ההתייחסות הוא אופציונלי אך מועיל."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शैली, विषय और अपेक्षित परिणाम का वर्णन करें। एक संदर्भ स्क्रीनशॉट वैकल्पिक लेकिन सहायक है।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelaskan gaya, subjek dan hasil yang diharapkan. Sebuah cuplikan referensi adalah opsional tapi membantu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタイル、被写体、予想される結果を記述します。参考スクリーンショットはオプションですが便利です。"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "uraikan gaya, subjek, dan hasil yang diharapkan. Sebuah cuplikan referensi adalah opsional tetapi berguna."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarzı açıklayın, konu ve beklenen sonuç. Bir referans görüntüsü isteğe bağlı ama yararlı."
