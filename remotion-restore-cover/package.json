{
  "name": "remotion-restore-cover",
  "version": "1.0.0",
  "description": "Looping before-and-after cover for the old photo restoration feature",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/media": "4.0.515",
    "@remotion/tailwind-v4": "4.0.515",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.515",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.515",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render RestoreComparisonCover out/restore-comparison-cover.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "render:enhance": "remotion render EnhanceVideoComparisonCover out/enhance-comparison-cover.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "render:enhance-photo": "remotion render EnhancePhotoComparisonCover out/enhance-photo-comparison-cover.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "render:gpt": "remotion render GPTImageMagicCover ../photoreviveaiedit/TemplateVideos/gpt_image_magic_cover.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "render:text-to-video": "remotion render TextToVideoWhaleCover out/text-to-video-whale-cover.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --muted",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
